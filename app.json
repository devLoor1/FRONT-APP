{
  "expo": {
    "name": "Loor",
    "slug": "loor",
    "version": "1.0.0",
    "scheme": "loor",
    "orientation": "portrait",
    "icon": "./assets/icons/icon-loor-v2.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-loor.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F9FB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.loor"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/icon-adaptive.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "br.com.loor"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "@logrocket/react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 25,
            "ndkVersion": "27.2.12479018"
          }
        }
      ]
    ],
    "owner": "wise-money",
    "extra": {
      "eas": {
        "projectId": "865565b6-4613-401e-b399-0b28fc5bc42e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/865565b6-4613-401e-b399-0b28fc5bc42e"
    }
  }
}
