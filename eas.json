{
  "cli": {
    "version": ">= 16.13.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "ENV": "DEV"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "ENV": "PREVIEW"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "ENV": "PROD"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "KNC9427V72",
        "companyName": "Loor"
      }
    }
  }
}
